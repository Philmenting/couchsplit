  "new_exp_share_evidence": [
    "Both sixth-slot holders receive native EXP and EVs with either battle initiator and in wild/trainer battles.",
    "Two owners evolve their late-slot holders and retain their own dex, EXP and items after native saving and reload.",
    "The second owner learns a move while the first presses B, with either battle initiator.",
    "Four EXP Share holders owned by one player receive native EXP and EVs with either initiator.",
    "Both owners select their sixth Pokemon while a resident late-slot EXP Share holder still receives its award.",
    "When mandatory slots exceed six, both actual machine states, parties and wallets remain unchanged at rejection."
  ],
  "story_evidence": [
    "Original Bill ticket conversation with either source player and a full recipient key-item pocket: no false receipt, one delayed ticket, native save and fresh Continue.",
    "Regression cases for Rocket barrier, Tower grunt, full-berry Lostelle, Marowak, Blaine, Giovanni, paired Champion and the own-starter network special."
  ],
