+// CouchSplit XROM v1 data aperture: file offset 32 MiB maps to 0x10000000.
+// Ordinary cartridges never enable it. Native ROM mirrors and save buses stay intact.
+bool GBACouchSplitIsXrom(const struct GBA* gba, uint32_t address) {
+	return gba->memory.couchsplitXrom && address >= 0x10000000U && address < 0x2E000000U;
+}
+void GBACouchSplitSetXrom(struct GBA* gba, const void* data, size_t size) {
+	gba->memory.couchsplitXrom = size && size <= 480U * 1024U * 1024U ? data : NULL;
+	gba->memory.couchsplitXromSize = gba->memory.couchsplitXrom ? size : 0;
+	for (unsigned i = 0x10; i < 0x2E; ++i) {
+		gba->memory.waitstatesNonseq16[i] = gba->memory.couchsplitXrom ? 4 : 0;
+		gba->memory.waitstatesNonseq32[i] = gba->memory.couchsplitXrom ? 8 : 0;
+		gba->memory.waitstatesSeq16[i] = gba->memory.couchsplitXrom ? 2 : 0;
+		gba->memory.waitstatesSeq32[i] = gba->memory.couchsplitXrom ? 4 : 0;
+	}
+}
+static uint32_t _couchsplitXromRead(const struct GBA* gba, uint32_t address, unsigned width) {
+	uint32_t offset = (address & ~(width - 1)) - 0x10000000U;
+	uint32_t value = 0;
+	for (unsigned i = 0; i < width; ++i) {
+		uint32_t byte = offset + i < gba->memory.couchsplitXromSize ? gba->memory.couchsplitXrom[offset + i] : 0xFF;
+		value |= byte << (8 * i);
+	}
+	return value;
+}
